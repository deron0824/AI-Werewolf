# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不会入库

# 路线 A（WorkBuddy 云服务）首选模型 id；留空 = 自动取模型列表第一个可用模型
# 示例：deepseek-v4.1-flash / glm-5.3-flash / hy4free
WB_PREFERRED_MODEL_ID=

# 节奏倍率（0.5 = 全部延迟减半；0 = 最小延迟，适合调试/e2e）
SPEED_MODE=1

# LLM 单次调用超时（毫秒）
LLM_TIMEOUT_MS=10000

# AI 发言字幕流式速度（字/秒）
SPEECH_DISPLAY_CPS=8
